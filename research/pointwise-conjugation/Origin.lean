import ReadingTransport
import Mathlib.Tactic

namespace Hearthline.Origin

variable {G V : Type*} [Group G] [AddCommGroup V]

/-- The additive subgroup generated by all reported values. -/
def readings (x : G → V) : AddSubgroup V := AddSubgroup.closure (Set.range x)

/-- The subgroup generated by changes from the reading at the identity. -/
def changes (x : G → V) : AddSubgroup V :=
  AddSubgroup.closure (Set.range fun g ↦ x g - x 1)

variable {A : G → V →+ V} {x : G → V} (law : ∀ g h, x (g*h) = x g + A g (x h))
include law

theorem kills_origin (g : G) : A g (x 1) = 0 := by
  simpa using law g 1

theorem update_reading (g h : G) : A g (x h) = x (g*h) - x g := by
  rw [law, add_sub_cancel_left]

theorem identity_reading (h : G) : A 1 (x h) = x h - x 1 := by
  simpa only [one_mul] using update_reading law 1 h

/-- Associativity of the position group forces composition on each actual reading. -/
theorem compose_reading (g h k : G) : A g (A h (x k)) = A (g*h) (x k) := by
  rw [update_reading law h k, map_sub, update_reading law g (h*k), update_reading law g h,
    update_reading law (g*h) k, mul_assoc]
  abel

/-- This equality extends to the subgroup generated by the readings, even though the
operators on the ambient group were supplied with no composition law. -/
theorem compose_on_readings (g h : G) {y : V} (hy : y ∈ readings x) :
    A g (A h y) = A (g*h) y := by
  induction hy using AddSubgroup.closure_induction with
  | mem y hy => obtain ⟨k, rfl⟩ := hy; exact compose_reading law g h k
  | zero => simp
  | add y z _ _ ih iz => simp [map_add, ih, iz]
  | neg y _ ih => simp [map_neg, ih]

/-- The update at one is the identity on changes. -/
theorem fixes_changes {y : V} (hy : y ∈ changes x) : A 1 y = y := by
  induction hy using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨k, rfl⟩ := hy
    rw [map_sub, identity_reading law k, kills_origin law 1, sub_zero]
  | zero => exact map_zero _
  | add y z _ _ ih iz => simp [map_add, ih, iz]
  | neg y _ ih => simp [map_neg, ih]

omit law in
lemma changes_le_readings : changes x ≤ readings x := by
  apply (AddSubgroup.closure_le _).2
  rintro _ ⟨g, rfl⟩
  exact (readings x).sub_mem (AddSubgroup.subset_closure ⟨g, rfl⟩)
    (AddSubgroup.subset_closure ⟨1, rfl⟩)

/-- Every update sends changes back into the same subgroup. -/
theorem update_mem_changes (g : G) {y : V} (hy : y ∈ changes x) : A g y ∈ changes x := by
  induction hy using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨h, rfl⟩ := hy
    rw [map_sub, kills_origin law, sub_zero, update_reading law]
    have a : x (g*h) - x 1 ∈ changes x := AddSubgroup.subset_closure ⟨g*h, rfl⟩
    have b : x g - x 1 ∈ changes x := AddSubgroup.subset_closure ⟨g, rfl⟩
    convert (changes x).sub_mem a b using 1; abel
  | zero => simp
  | add y z _ _ ih iz => simpa using (changes x).add_mem ih iz
  | neg y _ ih => simpa using (changes x).neg_mem ih

/-- The updates on changes are genuine additive automorphisms. -/
def action : G →* Multiplicative (AddAut (changes x)) where
  toFun g := Multiplicative.ofAdd
    { toFun := fun y ↦ ⟨A g y, update_mem_changes law g y.property⟩
      invFun := fun y ↦ ⟨A g⁻¹ y, update_mem_changes law g⁻¹ y.property⟩
      left_inv := fun y ↦ Subtype.ext <| by
        change A g⁻¹ (A g y.val) = y.val
        rw [compose_on_readings law _ _ (changes_le_readings y.property), inv_mul_cancel,
          fixes_changes law y.property]
      right_inv := fun y ↦ Subtype.ext <| by
        change A g (A g⁻¹ y.val) = y.val
        rw [compose_on_readings law _ _ (changes_le_readings y.property), mul_inv_cancel,
          fixes_changes law y.property]
      map_add' := fun y z ↦ Subtype.ext (map_add _ _ _) }
  map_one' := by
    apply Multiplicative.toAdd.injective
    exact AddEquiv.ext fun y ↦ Subtype.ext (fixes_changes law y.property)
  map_mul' g h := by
    apply Multiplicative.toAdd.injective
    exact AddEquiv.ext fun y ↦ Subtype.ext
      (compose_on_readings law g h (changes_le_readings y.property)).symm


/-- The reported values split internally into the changes and the cyclic subgroup generated
by the initial reading. The two subgroups meet only at zero. -/
theorem split :
    changes x ⊔ AddSubgroup.zmultiples (x 1) = readings x ∧
    Disjoint (changes x) (AddSubgroup.zmultiples (x 1)) := by
  have b0 : x 1 ∈ AddSubgroup.zmultiples (x 1) := AddSubgroup.mem_zmultiples _
  constructor
  · apply le_antisymm
    · exact sup_le changes_le_readings ((AddSubgroup.zmultiples_le).2 (AddSubgroup.subset_closure ⟨1, rfl⟩))
    · apply (AddSubgroup.closure_le _).2
      rintro _ ⟨g, rfl⟩
      have d : x g - x 1 ∈ changes x := AddSubgroup.subset_closure ⟨g, rfl⟩
      have incl₁ : changes x ≤ changes x ⊔ AddSubgroup.zmultiples (x 1) := le_sup_left
      have incl₂ : AddSubgroup.zmultiples (x 1) ≤ changes x ⊔ AddSubgroup.zmultiples (x 1) := le_sup_right
      have joint := (changes x ⊔ AddSubgroup.zmultiples (x 1)).add_mem (incl₁ d) (incl₂ b0)
      simpa using joint
  · refine disjoint_iff_inf_le.mpr ?_
    rintro y ⟨hd, n, rfl⟩
    have fixed := fixes_changes law hd
    rw [map_zsmul, kills_origin law, zsmul_zero] at fixed
    exact fixed.symm

/-- The component left invisible by the identity update in every conjugation error
is precisely the original offset. -/
theorem conjugation_residue (s g : G) :
    let error := x (s*g*s⁻¹) - A s (x g)
    error - A 1 error = x 1 := by
  intro error
  change x _ - A s (x g) - A 1 (x _ - A s (x g)) = x 1
  rw [map_sub, identity_reading law, compose_reading law 1, one_mul]
  abel

/-- Two additive update families producing the same values agree everywhere those values
generate. -/
theorem unique_on_readings {B : G → V →+ V} (other : ∀ g h, x (g*h) = x g + B g (x h))
    (g : G) {v : V} (hv : v ∈ readings x) : A g v = B g v := by
  induction hv using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨h, rfl⟩ := hy
    rw [update_reading law, update_reading other]
  | zero => simp
  | add y z _ _ ih iz => simp [map_add, ih, iz]
  | neg y _ ih => simp [map_neg, ih]

end Hearthline.Origin
