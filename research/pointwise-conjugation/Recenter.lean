import Origin

namespace Hearthline.Origin

variable {G V : Type*} [Group G] [AddCommGroup V]
  {A : G → V →+ V} {x : G → V} (law : ∀ g h, x (g*h) = x g + A g (x h))

/-- Keep the identity component of the generated readings when extending the updates
from changes to normalized additive automorphisms of the full generated subgroup. -/
def recenter (A : G → V →+ V) (g : G) : V →+ V := A g + (AddMonoidHom.id V - A 1)

theorem recenter_apply (g : G) (v : V) : recenter A g v = A g v + (v - A 1 v) := rfl

theorem recenter_one (v : V) : recenter A 1 v = v := by rw [recenter_apply]; abel

include law

theorem update_mem_readings (g : G) {y : V} (hy : y ∈ readings x) : A g y ∈ readings x := by
  induction hy using AddSubgroup.closure_induction with
  | mem z hz =>
    obtain ⟨h, rfl⟩ := hz
    rw [update_reading law g h]
    exact (readings x).sub_mem (AddSubgroup.subset_closure ⟨g*h, rfl⟩)
      (AddSubgroup.subset_closure ⟨g, rfl⟩)
  | zero => simp
  | add y z _ _ iy iz => simpa using (readings x).add_mem iy iz
  | neg y _ iy => simpa using (readings x).neg_mem iy

theorem recenter_mem (g : G) {y : V} (hy : y ∈ readings x) : recenter A g y ∈ readings x :=
  (readings x).add_mem (update_mem_readings law g hy) ((readings x).sub_mem hy (update_mem_readings law 1 hy))

theorem recenter_comp (g h : G) {y : V} (hy : y ∈ readings x) :
    recenter A g (recenter A h y) = recenter A (g*h) y := by
  simp only [recenter_apply, map_add, map_sub, compose_on_readings law _ _ hy, one_mul, mul_one]
  abel

theorem recenter_fixes_origin (g : G) : recenter A g (x 1) = x 1 := by
  simp [recenter_apply, kills_origin law]

/-- On the observed affine orbit the recentered operators and the original updates
give the same next reading. -/
theorem recenter_transition (g h : G) :
    x (g*h) = (x g - x 1) + recenter A g (x h) := by
  rw [law, recenter_apply, identity_reading law]
  abel

/-- The recentered operators act by genuine additive automorphisms on the full subgroup
generated by the readings. The ambient family is tested only on that subgroup. -/
def actionOnReadings : G →* Multiplicative (AddAut (readings x)) where
  toFun g := Multiplicative.ofAdd
    { toFun := fun y ↦ ⟨recenter A g y, recenter_mem law g y.property⟩
      invFun := fun y ↦ ⟨recenter A g⁻¹ y, recenter_mem law g⁻¹ y.property⟩
      left_inv := fun y ↦ Subtype.ext
        ((recenter_comp law g⁻¹ g y.property).trans (by rw [inv_mul_cancel, recenter_one]))
      right_inv := fun y ↦ Subtype.ext
        ((recenter_comp law g g⁻¹ y.property).trans (by rw [mul_inv_cancel, recenter_one]))
      map_add' := fun y z ↦ Subtype.ext (map_add _ _ _) }
  map_one' := by
    apply Multiplicative.toAdd.injective
    exact AddEquiv.ext fun y ↦ Subtype.ext (recenter_one y.val)
  map_mul' g h := by
    apply Multiplicative.toAdd.injective
    exact AddEquiv.ext fun y ↦ Subtype.ext (recenter_comp law g h y.property).symm

end Hearthline.Origin
